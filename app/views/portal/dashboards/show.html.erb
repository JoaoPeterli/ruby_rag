<h2 class="page-title mb-4">Início</h2>

<div class="row row-deck row-cards">
  <div class="col-sm-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader">Documentos</div>
        <div class="h1 mb-3"><%= @stats.documents[:total] %></div>
        <ul class="list-unstyled mb-2">
          <% @stats.documents[:by_status].each do |status, count| %>
            <li class="d-flex justify-content-between border-top py-1">
              <span class="text-secondary text-capitalize"><%= status %></span> <strong><%= count %></strong>
            </li>
          <% end %>
        </ul>
        <div class="text-secondary small"><%= @stats.documents[:total_chunks] %> chunks no total</div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader">Perguntas</div>
        <div class="h1 mb-3"><%= @stats.queries[:total] %></div>
        <div class="text-secondary small">
          <%= @stats.queries[:cache_hits] %> hits de cache
          (<%= number_to_percentage((@stats.queries[:cache_hit_rate] || 0) * 100, precision: 1) %>)
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader">Confiança das respostas</div>
        <div class="h1 mb-3"><%= @stats.confidence[:average_score] || "—" %></div>
        <ul class="list-unstyled mb-2">
          <% @stats.confidence[:by_level].each do |level, count| %>
            <li class="d-flex justify-content-between border-top py-1">
              <span class="text-secondary text-capitalize"><%= level %></span> <strong><%= count %></strong>
            </li>
          <% end %>
        </ul>
        <div class="text-secondary small"><%= @stats.confidence[:refused_count] %> recusadas por falta de evidência</div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader">Feedback</div>
        <div class="h1 mb-3"><%= @stats.feedback[:total] %></div>
        <ul class="list-unstyled mb-2">
          <% @stats.feedback[:by_rating].each do |rating, count| %>
            <li class="d-flex justify-content-between border-top py-1">
              <span class="text-secondary text-capitalize"><%= rating %></span> <strong><%= count %></strong>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
