<div class="page-header d-print-none mb-3">
  <div class="row align-items-center">
    <div class="col">
      <div class="mb-1">
        <%= link_to admin_users_path, class: "text-secondary" do %>
          <i class="ti ti-arrow-left"></i> Usuários
        <% end %>
      </div>
      <h2 class="page-title"><%= @user.email %></h2>
    </div>
    <div class="col-auto ms-auto d-flex gap-2">
      <%= link_to "Editar", edit_admin_user_path(@user), class: "btn btn-outline-primary" %>
      <%= button_to "Remover usuário", admin_user_path(@user), method: :delete, class: "btn btn-outline-danger",
            form: { data: { turbo_confirm: "Remover o usuário #{@user.email}?" } } %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <div class="datagrid">
      <div class="datagrid-item">
        <div class="datagrid-title">Conta</div>
        <div class="datagrid-content"><%= link_to @user.account.name, admin_account_path(@user.account) %></div>
      </div>
      <div class="datagrid-item">
        <div class="datagrid-title">Ativo?</div>
        <div class="datagrid-content"><span class="badge <%= @user.active? ? "bg-success-lt" : "bg-danger-lt" %>"><%= @user.active? ? "sim" : "não" %></span></div>
      </div>
      <div class="datagrid-item">
        <div class="datagrid-title">Criado em</div>
        <div class="datagrid-content"><%= @user.created_at.strftime("%d/%m/%Y %H:%M") %></div>
      </div>
    </div>
  </div>
</div>
